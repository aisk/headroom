<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Headroom</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Unpackaged by default so it can be run straight from the build output; pass -p:Packaged=true
         to build the MSIX package for the Microsoft Store. -->
    <WindowsPackageType Condition="'$(Packaged)' != 'true'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(Packaged)' == 'true'">MSIX</WindowsPackageType>
    <EnableMsixTooling Condition="'$(Packaged)' == 'true'">true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Trim-safe WinRT interop: CsWinRT generates the marshaling code for objects passed to XAML (view
         models must be partial) and warns about anything it cannot handle. -->
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(Packaged)' == 'true'">
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(Packaged)' != 'true'">
    <None Remove="Package.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CsWinRT 2.2 bundled with the Windows SDK projection does not generate interop for
         ObservableCollection<T> bound by x:Bind, so trimmed builds showed an empty panel. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- Only the Windows App SDK components the app uses. The Microsoft.WindowsAppSDK metapackage also
         pulls in AI, ML, Search and Widgets, which add about 70 MB (ONNX Runtime, DirectML) to the
         self-contained package. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Headroom.Core\Headroom.Core.csproj" />
  </ItemGroup>

  <!-- Publish Properties: Release publishes are compiled with Native AOT (which also trims), so the
       package carries no CoreCLR runtime or JIT. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
</Project>
